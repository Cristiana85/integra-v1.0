@startuml
title INTEGRA Solver - Internal WASM Operational Flow

skinparam shadowing false
skinparam ArrowColor #333
skinparam ActivityBackgroundColor #ffffff
skinparam ActivityBorderColor #333

start

:Session.run(run_id);

if (Model set?) then (yes)
else (no)
  :Emit ERROR\nMODEL_INVALID "Model not set";
  stop
endif

if (Analysis set?) then (yes)
else (no)
  :Emit ERROR\nANALYSIS_INVALID "Analysis not set";
  stop
endif

:Build SolverContext\n{run_id, model, analysis};

:Emit PROGRESS 1%\n"setup";

:Dispatcher.run(ctx);

if (ModelPayload + AnalysisPayload match?) then (yes)
  :Select calculator\n(e.g. TLINE);
else (no)
  :Emit ERROR\nMODEL_ANALYSIS_MISMATCH;
  stop
endif

:Calculator.validate(model, analysis);
if (Validation OK?) then (yes)
else (no)
  :Emit ERROR\nMODEL_INVALID / ANALYSIS_INVALID\n(with path/details);
  stop
endif

:Build SolverRuntime\n(mapped + units converted + derived params);

:Decide backend\nCPU vs WebGPU\n(from analysis.common.use_webgpu);

:Emit PROGRESS 5%\n"build sweep";

if (Sweep present?) then (yes)
  :Get sweep values;
else (no)
  :Create default sweep;
endif

repeat
  :Take next sweep point;
  :Emit PROGRESS\n"solving @ point";
  :Core solve step\n(algorithm / kernel dispatch);
repeat while (more points?) is (yes)

:Emit PROGRESS 95%\n"post-processing";
:Post-process\n(dB, unwrap, derived outputs);

:Fill Dataset\n(meta + independent + dependent);

:Serialize Envelope(done)\n{dataset};
:Emit DONE callback;

stop
@enduml
