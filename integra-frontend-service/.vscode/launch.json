{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Angular: Debug Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "ng serve",
      "runtimeArgs": [
        "--disable-web-security",
        "--explicitly-allowed-ports=5060"
      ]
    }
  ]
}
